# Environment Variables Template
# Copy this file to .env and fill in your values

# OpenAI Configuration (required for embeddings and chat)
OPENAI_API_KEY=your_openai_api_key_here

# Database — optional locally; defaults to sqlite:///./folio.db in database.py.
# Use PostgreSQL for analytics parity with production (see backend/docs/ANALYTICS-SETUP.md).
# DATABASE_URL=postgresql://user:pass@localhost:5432/folio_db

# Application Configuration
PORT=8000
